{
  "name": "innovativenovels",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run validate:content && vite build",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/novel-mark.svg",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "validate:content": "vitest run src/infrastructure/content/catalogContentLoader.test.ts",
    "apply:published-append-candidate": "node --loader ./scripts/typescript-loader.mjs ./scripts/apply-published-append-candidate.mjs",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "verify:wrapper": "node scripts/verify-wrapper.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10"
  }
}
